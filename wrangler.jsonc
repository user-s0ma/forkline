{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forkline",
  "main": "src/workers/app.ts",
  "compatibility_date": "2026-10-06",
  // Stripe の SDK が Node の API を使うため nodejs_compat を有効にする
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "pattern": "forkline.ai",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "VITE_PUBLIC_APP_URL": "https://forkline.ai",
    // Cloudflare Turnstile のサイトキーを設定する
    "VITE_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFjmFmtIhyGgYro3",
    // 呼ばれないまま、この分数が過ぎた Nebius のエンドポイントを止める
    "ENDPOINT_IDLE_MINUTES": "15",
    // 売上を出金できるようになるまでの日数 (チャージの返金・チャージバックに備えて保留する)
    "EARNINGS_HOLD_DAYS": "7"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "build/client"
  },
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "forkline-storage"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  // /v1 の呼び出しを API キーごとに制限する
  "ratelimits": [
    {
      "name": "GATEWAY_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  // 1分ごとに、学習の状態を確かめ、エンドポイントの GPU 代を請求し、使われていないものを止める
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
