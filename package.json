{
  "name": "forkline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .dev.vars -- vite dev",
    "build": "vite build",
    "start": "vite preview",
    "lint": "eslint src/ tests/",
    "test": "tsx --test tests/*.test.ts",
    "preview": "dotenv -e .dev.vars -- npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "dotenv -e .dev.vars -- drizzle-kit generate",
    "db:migrate": "dotenv -e .dev.vars -- drizzle-kit migrate",
    "db:studio": "dotenv -e .dev.vars -- drizzle-kit studio",
    "type-check": "react-router typegen && tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@cf-wasm/og": "^0.5.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@marsidev/react-turnstile": "^1.5.3",
    "@tanstack/react-query": "^5.101.2",
    "@tidbcloud/serverless": "^0.3.0",
    "better-auth": "1.6.23",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.13",
    "i18next": "^26.3.4",
    "isbot": "^5.1.44",
    "lucide-react": "^1.23.0",
    "react": "~19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "~19.2.7",
    "react-i18next": "^17.0.8",
    "react-router": "^8.4.0",
    "sonner": "^2.0.7",
    "stripe": "^22.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^11",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "mysql2": "^3.24.5",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "wrangler": "^4.149.0"
  }
}
