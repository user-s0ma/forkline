# Forkline の前段。HTTPS の証明書を Let's Encrypt から取り、Node (127.0.0.1:3000) に渡す。
# SITE_ADDRESS は /etc/systemd/system/caddy.service.d/site.conf で決める (例: "forkline.ai")
{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000 {
		# 呼び出し側が送ってきた転送ヘッダーは信用せず、Caddy が付け直す
		header_up -X-Real-Ip
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
