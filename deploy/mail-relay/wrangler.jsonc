{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "forkline-mail-relay",
  "main": "index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "AUTH_EMAIL_FROM": "noreply@forkline.ai"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "enabled": true
  }
}
