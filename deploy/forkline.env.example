# 本番 (Nebius の VM) の設定。手元では .env.production.local に写して埋め、deploy/push-env.sh で VM の /etc/forkline/forkline.env に送る。
# systemd の EnvironmentFile として読む。秘密鍵は改行を \n と書いて1行にし、単引用符で囲む (囲まないと \ が消える)

VITE_PUBLIC_APP_URL=https://forkline.ai
VITE_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFjmFmtIhyGgYro3
ENDPOINT_IDLE_MINUTES=15
EARNINGS_HOLD_DAYS=7

# メール送信 (Cloudflare Email Service の REST API)。トークンには Email Sending の権限を付ける
CLOUDFLARE_ACCOUNT_ID=424609b50dfe49b156a6ec4a85c9ae88
CLOUDFLARE_EMAIL_API_TOKEN=
AUTH_EMAIL_FROM=noreply@forkline.ai

DATABASE_URL=
BETTER_AUTH_SECRET=
SECRET_ENCRYPTION_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

NEBIUS_PROJECT_ID=
NEBIUS_REGION=eu-north1
NEBIUS_SERVICE_ACCOUNT_ID=
NEBIUS_AUTHORIZED_KEY_ID=
NEBIUS_AUTHORIZED_PRIVATE_KEY=
NEBIUS_TRAIN_IMAGE=
NEBIUS_SERVE_IMAGE=
NEBIUS_S3_ENDPOINT=
NEBIUS_S3_BUCKET=
NEBIUS_S3_ACCESS_KEY_ID=
NEBIUS_S3_SECRET_ACCESS_KEY=
NEBIUS_TOKEN_FACTORY_API_KEY=
