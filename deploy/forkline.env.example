# Nebius の VM で動かすときの設定 (/etc/forkline/forkline.env、所有者 forkline、権限 600)。
# wrangler.jsonc の vars と、Cloudflare に `wrangler secret put` で入れていたものを、ここにまとめて書く。
# 値は引用符で囲まない (systemd の EnvironmentFile として読む)。秘密鍵の改行は \n と書く

VITE_PUBLIC_APP_URL=https://forkline.ai
VITE_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFjmFmtIhyGgYro3
ENDPOINT_IDLE_MINUTES=15
EARNINGS_HOLD_DAYS=7

# メール送信の中継 (deploy/mail-relay)。MAIL_RELAY_SECRET は中継の RELAY_SECRET と同じ値
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
AUTH_EMAIL_FROM=noreply@forkline.ai

DATABASE_URL=
BETTER_AUTH_SECRET=
SECRET_ENCRYPTION_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

NEBIUS_PROJECT_ID=
NEBIUS_REGION=eu-north1
NEBIUS_SERVICE_ACCOUNT_ID=
NEBIUS_AUTHORIZED_KEY_ID=
NEBIUS_AUTHORIZED_PRIVATE_KEY=
NEBIUS_TRAIN_IMAGE=
NEBIUS_SERVE_IMAGE=
NEBIUS_S3_ENDPOINT=
NEBIUS_S3_BUCKET=
NEBIUS_S3_ACCESS_KEY_ID=
NEBIUS_S3_SECRET_ACCESS_KEY=
NEBIUS_TOKEN_FACTORY_API_KEY=
